{
  "name": "exo-mind",
  "version": "0.5.5",
  "description": "Personal knowledge engine: YouTube playlist or article links → transcript → summary → connected markdown notes",
  "author": "Matthew Bartlett",
  "license": "PolyForm-Shield-1.0.0",
  "scripts": {
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "dev": "EXO_DEV=1 tsx watch server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "share:build": "vite build -c vite.share.config.ts",
    "share:deploy": "vite build -c vite.share.config.ts && cd cloudflare && npx wrangler pages deploy",
    "app": "electron .",
    "app:build": "node scripts/build-app.mjs",
    "app:dist": "npm run app:build && electron-builder --mac",
    "app:install": "npm run app:dist && node scripts/install-app.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "d3-force": "^3.0.0",
    "electron": "^44.11.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.13",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs"
}
